+def resolve_model_source(name):
+    """Resolve bundled model ids without changing checkpoint metadata.
+
+    KEV checkpoints record their original Hub base id and compare it during a
+    delta warm start.  Keeping that id intact preserves compatibility, while
+    this resolver redirects file access to the optional offline bundle.
+    """
+    root = os.environ.get("KEV_LOCAL_MODEL_ROOT")
+    if not root:
+        return name
+    repo = str(name).partition("@")[0]
+    local_names = {
+        "Qwen/Qwen3.5-0.8B-Base": "qwen3.5-0.8b-base",
+        "Qwen/Qwen3.5-4B-Base": "qwen3.5-4b-base",
+        "jaredpalmer/kev-0.8b": "kev-0.8b",
+        "jaredpalmer/kev-4b": "kev-4b",
+    }
+    candidate = os.path.join(root, local_names.get(repo, ""))
+    return candidate if local_names.get(repo) and os.path.isdir(candidate) else name
+
