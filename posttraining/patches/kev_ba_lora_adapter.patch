+def ba_diversity_loss(logits):
+    """BA-LoRA diversity regularizer adapted from token logits to option logits."""
+    values = []
+    for z in logits:
+        p = F.softmax(z.float(), -1)
+        values.append((p * p.clamp_min(1e-8).log()).sum())
+    return sum(values) / len(values) if values else None
+
+
+def ba_svd_loss(logits, top_k=10, frobenius=True):
+    """BA-LoRA SVD regularizer specialized to variable-size choice logits.
+
+    The official implementation applies SVD to a rectangular matrix whose
+    rows share one output space. KEV questions can have different numbers of
+    choices, so we form one matrix per K instead of padding or mixing spaces.
+    Group losses are averaged by their number of questions.
+    """
+    groups = defaultdict(list)
+    for z in logits:
+        groups[z.numel()].append(z.float())
+    values, weights = [], []
+    for rows in groups.values():
+        if len(rows) < 2 or rows[0].numel() < 2:
+            continue
+        try:
+            s = torch.linalg.svdvals(torch.stack(rows))
+        except torch.linalg.LinAlgError:
+            continue
+        norm = torch.sqrt(torch.sum(s * s)) if frobenius else torch.sum(s)
+        if norm.detach() > 1e-8:
+            values.append(-torch.sum(s[:min(top_k, len(s))]) / norm)
+            weights.append(len(rows))
+    if not values:
+        return None
+    return sum(v * w for v, w in zip(values, weights)) / sum(weights)
+
+
+def ba_regularization_weights(a, step, total_steps):
+    """Official BA-LoRA cosine and focus schedules for lambda1/2/3."""
+    total_steps = max(total_steps, 1)
+    consistency = a.anchor_w
+    if a.ba_consistency_schedule == "cosine":
+        final = 0.1 * consistency
+        decay = 0.5 * (1.0 + math.cos(math.pi * step / total_steps))
+        consistency = final + (consistency - final) * decay
+
+    focus = 1.0
+    warmup_steps = int(a.ba_warmup_ratio * total_steps)
+    if a.ba_focus_schedule == "two_phase":
+        ramp_steps = max(int(a.ba_ramp_up_ratio * total_steps), 1)
+        if step < warmup_steps:
+            focus = 0.0
+        elif step < warmup_steps + ramp_steps:
+            focus = (step - warmup_steps) / ramp_steps
+    elif a.ba_focus_schedule in ("linear_warmup", "quadratic_warmup") and step < warmup_steps:
+        progress = step / warmup_steps if warmup_steps else 1.0
+        focus = progress if a.ba_focus_schedule == "linear_warmup" else progress * progress
+    return consistency, a.ba_div_w * focus, a.ba_svd_w * focus
+
